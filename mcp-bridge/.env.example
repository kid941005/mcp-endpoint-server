# Tool-side WebSocket URL printed by mcp-endpoint-server.
# Do not URL-encode the token again.
MCP_ENDPOINT=ws://127.0.0.1:8004/mcp_endpoint/mcp/?token=replace-with-tool-token
MCP_TRANSPORT=stdio
MCP_SERVER_NAME=reminder

# stdio
MCP_COMMAND=python
MCP_ARGS=["/app/server.py"]
# MCP_CWD=/app
# MCP_ENV={"REMINDER_API_URL":"http://127.0.0.1:8906"}

# SSE / Streamable HTTP
# MCP_TRANSPORT=sse
# MCP_URL=http://127.0.0.1:8080/sse
# MCP_TRANSPORT=streamable-http
# MCP_URL=http://127.0.0.1:8080/mcp
# MCP_HEADERS={"Authorization":"Bearer replace-me"}
# Set to 1 only when the MCP server must be reached through HTTP_PROXY.
# MCP_HTTP_TRUST_ENV=1

MCP_TIMEOUT=30
MCP_SSE_READ_TIMEOUT=300
MCP_MAX_SIZE=16777216
MCP_RECONNECT_INITIAL=1
MCP_RECONNECT_MAX=60
MCP_LOG_LEVEL=INFO
